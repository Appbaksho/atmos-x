# Atmos X V1 environment template (see prompt-v1.md §8.5).
#
# Setup:
#   cp .env.example .env     Fill in .env at the repo root. It is the only env file people edit.
#   make env                 Copies ONLY the web variables (section 2) into apps/web/.env.local,
#                            so the Next.js server never holds a backend secret.
#
# Rules:
#   - .env is gitignored. Never commit it, paste it into chat, or print it.
#   - Section 1 is server-only. Never give those variables a NEXT_PUBLIC_ prefix.
#   - Empty optional value = that integration is off, and the app says so instead of faking data.
#
# Core heat loop needs no third-party key: Landsat, HLS, MODIS and WorldCover (Microsoft Planetary
# Computer), NASA POWER, GEOS-FP and GEOS-CF (NCCS), NEX-GDDP-CMIP6 (NCCS), ORNL MODIS, NASA GIBS,
# Open-Meteo (free tier, non-commercial), Nominatim and Overpass.
# There is no OpenAI or Google Earth Engine configuration: V1 uses neither (prompt-v1.md §3).


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1. SERVER-ONLY: apps/api and its worker. Never exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core (required) ---

# development | test | production. Production refuses to start with DATA_MODE=fixture,
# a placeholder JWT_SECRET, or SMS_PROVIDER=console.
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Postgres + PostGIS. This default matches the local docker-compose service (make db), which
# listens on 127.0.0.1:5433 so it never collides with a Postgres already on 5432.
DATABASE_URL=postgresql+asyncpg://atmos:atmos@localhost:5433/atmos

# Signs session cookies. Generate per environment: openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32

# false on http://localhost, true behind HTTPS.
COOKIE_SECURE=false

# Public origin of the web app. Used for invite links and payment return URLs.
PUBLIC_WEB_ORIGIN=http://localhost:3000

# live = real sources only. fixture = recorded test data, for automated tests and offline
# development only (every response is labelled demo, and production refuses it).
DATA_MODE=live

# Holds uploads/ and static/ (static NASA files, IP-to-city database). Relative to apps/api.
DATA_DIR=./data

# --- NASA Earthdata Login (optional; the only NASA credential V1 uses) ---
# Unlocks ECOSTRESS LST, GPM IMERG rain, SMAP soil moisture, the LIS/OTD lightning climatology and
# the GPWv4 population grid. Without it the app falls back to the sources in prompt-v1.md §5.3 and
# labels them. No api.nasa.gov key is used: POWER, GEOS, GIBS and ORNL are keyless.
# Get it at https://urs.earthdata.nasa.gov, then approve the applications in DEV-CHECKLIST §3.2.
# Prefer username + password on long-running servers, because user tokens expire (about 60 days).
# If EARTHDATA_TOKEN is set, it takes precedence over the password.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# --- Other data services ---

# Measured PM2.5 stations (optional). Free key: https://explore.openaq.org → Account → API key.
# Empty = no station list; modelled PM2.5 is still shown.
OPENAQ_API_KEY=

# Empty = Open-Meteo's free tier, which its terms limit to non-commercial use and under 10,000
# calls a day. Subscribe and set this BEFORE the Store takes real money: https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# Required by the Nominatim and Overpass usage policies. Must be a real team contact address;
# Nominatim rejects placeholder contacts.
OSM_USER_AGENT="AtmosX/1.0 (replace-with-real-team-contact@your-domain)"

# Overpass mirrors, tried in order. These are public servers and often fail, so Overpass runs only
# inside worker jobs, never during a user request.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# --- Limits ---

# Ask Atmos messages per day. Enforced on the server.
ASK_DAILY_LIMIT_USER=30
ASK_DAILY_LIMIT_GUEST=5

# --- Sign-in ---

# "Continue with Google" (optional; empty = button disabled). The client id reaches the browser
# through GET /api/v1/auth/google/config; the secret stays on the server.
# Google Cloud console → Credentials → OAuth client ID (Web). Add every origin (DEV-CHECKLIST §1.6).
# Create a NEW secret: the one committed in apps/web/.env.example is public and must be rotated.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Phone OTP. console = logs the code on the server, for development only.
# twilio = Twilio Verify. Other gateways plug in behind the same adapter (prompt-v1.md §6.2).
SMS_PROVIDER=console

# Required only when SMS_PROVIDER=twilio. From https://console.twilio.com → Verify → Services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Payments (optional; empty = checkout shows "not available yet") ---

# SSLCommerz handles card, bKash and Nagad on its hosted page. Sandbox and live stores have
# different credentials. Register a sandbox store at https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# true = sandbox, no real money. Only a person may set this to false.
SSLCOMMERZ_SANDBOX=true

# --- Store and marketplace (proposals in prompt-v1 §14; change only with the team) ---

# VAT on every invoice, as a fraction.
VAT_RATE=0.15
# M22: a store listing's points price must be within ± POINTS_PRICE_TOLERANCE of
# declared value (taka) × POINTS_PER_BDT.
POINTS_PER_BDT=2.0
POINTS_PRICE_TOLERANCE=0.25
# S15: redemptions per person and per device each calendar month; vouchers last VOUCHER_DAYS.
STORE_MONTHLY_PER_PERSON=4
STORE_MONTHLY_PER_DEVICE=6
VOUCHER_DAYS=14
# M5–M7 prices in taka: one tree with 3 years of care, a store listing per year, one certified tonne.
TREE_PACKAGE_BDT=1500
STORE_LISTING_FEE_BDT=25000
CREDIT_PRICE_BDT=2500
# Rough CO₂ estimate per young urban tree per year (always labelled an estimate, never an offset).
CO2_KG_PER_TREE_YEAR=10
# Bank transfer is offered for orders at or above this amount.
BANK_TRANSFER_MIN_BDT=200000

# --- Photo moderation ---

# manual = every public photo waits in the moderator queue.
# google_vision = automatic nudity and violence check first; anything flagged, or any failure of
# the check, still goes to the queue.
MODERATION_PROVIDER=manual

# Required only when MODERATION_PROVIDER=google_vision. Google Cloud → enable Cloud Vision API →
# create an API key restricted to that API.
GOOGLE_VISION_API_KEY=

# --- Web push (optional; empty = in-app notifications only) ---

# Generate with: cd apps/api && uv run python -m app.scripts.make_vapid (or npx web-push generate-vapid-keys).
# Push stays off while either key is empty.
# The public key reaches the browser through GET /api/v1/push/config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-real-team-contact@your-domain


# --- Docker compose ---

# Dev database port on 127.0.0.1 (docker-compose.yml, `make db`).
POSTGRES_PORT=5433
# Production compose only (docker-compose.prod.yml): Postgres for the db service; the api and
# worker build DATABASE_URL from these.
POSTGRES_USER=atmos
POSTGRES_PASSWORD=
POSTGRES_DB=atmos
# Host port nginx proxies to (127.0.0.1 only).
WEB_PORT=3160


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2. WEB: apps/web. Contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server and build side (not sent to the browser) ---

# Where the Next.js rewrites send /api/v1/* and /media/*.
API_ORIGIN=http://localhost:8000

# Optional service-worker build stamp, e.g. a git hash. Empty = build time.
ATMOS_BUILD_ID=

# --- PUBLIC: every NEXT_PUBLIC_ value is compiled into the browser bundle. No secrets here. ---

# Public URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keyless basemap style. The dark style is optional; empty = restyle the light one at runtime.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# Optional override for the self-hosted MapLibre worker. Empty = /maplibre/<version>/.
NEXT_PUBLIC_MAPLIBRE_WORKER_URL=

# Optional IANA time zone for server-rendered dates. Empty = Asia/Dhaka.
NEXT_PUBLIC_TIME_ZONE=

# The "Try the Dhaka demo" point. Mohammadpur, Dhaka by default.
NEXT_PUBLIC_DEMO_LAT=23.7590
NEXT_PUBLIC_DEMO_LNG=90.3590

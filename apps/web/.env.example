OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_CHEAP=gpt-5.4-mini
AI_DAILY_REQUEST_CAP=1500
OSM_USER_AGENT="AtmosX/0.1 (atmosx-dev@example.com)"
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL_DARK=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_LAT=23.7590
NEXT_PUBLIC_DEMO_LNG=90.3590

# Optional overrides (leave empty in normal use)
# Self-hosted MapLibre worker is the default (/maplibre/<version>/); set a URL to use a CDN instead.
NEXT_PUBLIC_MAPLIBRE_WORKER_URL=
# Rehearse the offline safety net: point upstreams at a dead host (e.g. http://127.0.0.1:9) and
# ATMOS_CACHE_DIR at an empty folder; every demo screen then renders from src/server/snapshots/dhaka.
OPEN_METEO_BASE_URL=
OPEN_METEO_FORECAST_URL=
OPEN_METEO_ARCHIVE_URL=
OPEN_METEO_AIR_URL=
OPEN_METEO_GEOCODING_URL=
NOMINATIM_URL=
NASA_POWER_URL=
ATMOS_CACHE_DIR=

# apps/web environment. The source of truth is the ROOT .env.example (prompt-v1.md §8.5).
#
#   cp .env.example .env      (at the repo root, then fill it in)
#   make env                  (copies ONLY the variables below into apps/web/.env.local)
#
# The Next.js server holds no backend secret: every API key lives in apps/api.
# Every NEXT_PUBLIC_ value is compiled into the browser bundle, so never put a secret here.

# Where the Next.js rewrites send /api/v1/* and /media/* (the FastAPI server).
API_ORIGIN=http://localhost:8000

# Optional service-worker build stamp, e.g. a git hash. Empty = build time.
ATMOS_BUILD_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL_DARK=
NEXT_PUBLIC_MAPLIBRE_WORKER_URL=
NEXT_PUBLIC_TIME_ZONE=
NEXT_PUBLIC_DEMO_LAT=23.7590
NEXT_PUBLIC_DEMO_LNG=90.3590

# Atmos X: reverse proxy to the docker compose "web" service on 127.0.0.1:3160. The web service
# rewrites /api/v1 and /media to the api service, so nginx needs only this one upstream.
# Installed as /etc/nginx/sites-available/atmosx; certbot --nginx adds the 443/ssl lines.
server {
    listen 80;
    listen [::]:80;
    server_name atmosx.baksho.app;
    # Action photos and company documents (up to 10 MB each) are multipart uploads.
    client_max_body_size 12M;

    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; allow all; }

    location / {
        proxy_pass http://127.0.0.1:3160;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Ask Atmos streams server-sent events; don't hold them back.
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
}
